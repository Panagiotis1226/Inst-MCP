# Copy to .env (or let `npm run setup-token` write it for you). Never commit .env.
IG_AUTH_MODE=facebook
IG_API_VERSION=v25.0

# Meta app (App Dashboard > App settings > Basic)
IG_APP_ID=
IG_APP_SECRET=

# Written by setup-token
IG_USER_TOKEN=
IG_USER_TOKEN_EXPIRES_AT=
IG_PAGE_ID=
IG_PAGE_TOKEN=
IG_USER_ID=
IG_USERNAME=

# Instagram Login mode only: paste the token from the App Dashboard "Generate token" button
# IG_ACCESS_TOKEN=

# Optional probe settings
# PROBE_DISCOVERY_USERNAME=instagram   # public Business/Creator account for the business-discovery test
# PROBE_HASHTAG=sunset                 # uses 1 of your 30 unique hashtag searches per 7 days
# PROBE_IMAGE_URL=https://...jpg       # public JPEG for the (never published) container test
# PROBE_DM_RECIPIENT=                  # IGSID of a tester account that already messaged you
